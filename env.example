# Copia este fichero como ".env" para probar en tu PC (el .env NO se sube a GitHub).
# En Railway estas mismas claves se ponen en la pestaña "Variables".

# Obligatorias
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opciones del scanner (todas las de `python bingx_scanner.py --help`)
# Recomendada: Bybit, 5m, fractal de 30m como +1 punto, tope de riesgo 2.5 ATR
SCANNER_ARGS=--source bybit --tf 5m --frac bonus --max-risk-atr 2.5

# 1 = solo avisar de señales fuertes (LONG+ / SHORT+)
ONLY_STRONG=0

# Informe diario ("sigo activo" + resultados de las señales) cada N horas; 0 = desactivado
HEARTBEAT_HOURS=24

# 1 = avisar también cuando cada señal termina (TP1/TP2/stop). 0 = solo en el informe diario
NOTIFY_OUTCOMES=0

# Velas máximas que se sigue una señal antes de darla por expirada
# (96 velas de 5m = 8 h; con 15m usa 32). Vacío = 8 h automático según --tf
TRACK_BARS=96

# Dónde se guarda el seguimiento. En Railway solo sobrevive a un redeploy si lo pones en un Volume
# (p. ej. montas un Volume en /data y pones STATE_FILE=/data/state.json)
STATE_FILE=state.json

# Zona horaria para las horas de los mensajes
TZ_NAME=Europe/Madrid
